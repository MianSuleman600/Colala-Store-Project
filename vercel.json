{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    }
  ],
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/workbox-*.js",
      "destination": "/workbox-*.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
